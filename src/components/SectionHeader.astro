---
interface Props {
  label: string;
  title: string;
  description: string;
  dark?: boolean;
}

const { label, title, description, dark = false } = Astro.props;
---

<div class={dark ? 'dark-header' : ''}>
  <div class={`section-label ${dark ? 'dark-label' : ''}`}>{label}</div>
  <h2 class={dark ? 'dark-title' : ''}>{title}</h2>
  <p class={`lead ${dark ? 'dark-lead' : ''}`}>{description}</p>
</div>

<style>
  .dark-label {
    color: rgba(255, 255, 255, 0.35);
  }

  .dark-title {
    color: white;
  }

  .dark-lead {
    color: rgba(255, 255, 255, 0.55);
  }
</style>
