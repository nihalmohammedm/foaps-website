<footer>
  <img src="/foaps-logo.svg" alt="Foaps" />
  <div class="footer-links">
    <a href="#">Products</a>
    <a href="#">Blog</a>
    <a href="#">Contact</a>
    <a href="#">Privacy</a>
  </div>
  <div class="footer-copy">© 2026 Lasper Technologies Pvt. Ltd.</div>
</footer>

<style>
  footer {
    padding: 56px 6%;
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 24px;
  }

  .footer-logo {
    font-size: 20px;
    font-weight: 800;
    color: var(--orange);
  }

  .footer-links {
    display: flex;
    gap: 28px;
  }

  .footer-links a {
    font-size: 13px;
    color: var(--ink-4);
    font-weight: 500;
    transition: color 0.2s;
  }

  .footer-links a:hover {
    color: var(--ink);
  }

  .footer-copy {
    font-size: 13px;
    color: var(--ink-4);
  }
</style>
