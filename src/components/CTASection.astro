<section class="cta-section" id="cta">
  <div class="section-label" style="color:rgba(255,255,255,.35)">Get Started</div>
  <h2>Ready to run your business smarter?</h2>
  <p class="cta-sub">Talk to our team and find the right Foaps products for your business — free consultation, no pressure.</p>
  <a href="https://wa.me/919999999999" class="btn btn-fill">Chat with us on WhatsApp →</a>
  <div class="cta-products">
    <span class="cta-pill">🍽 Foaps Receiver</span>
    <span class="cta-pill">💬 Foaps Direct</span>
    <span class="cta-pill">🚀 Orderpipe</span>
    <span class="cta-pill">📣 Foaps Engage</span>
    <span class="cta-pill">🛵 Foaps Navigate</span>
  </div>
</section>

<style>
  .cta-section {
    padding: 120px 6%;
    background: var(--ink);
    text-align: center;
  }

  .section-label {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-4);
    margin-bottom: 14px;
  }

  .cta-section h2 {
    color: white;
    max-width: 680px;
    margin: 0 auto 20px;
  }

  .cta-section .cta-sub {
    font-size: 18px;
    color: rgba(255, 255, 255, 0.5);
    max-width: 440px;
    margin: 0 auto 44px;
  }

  .cta-section .btn-fill {
    font-size: 16px;
    padding: 15px 36px;
  }

  .cta-products {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin-top: 40px;
    flex-wrap: wrap;
  }

  .cta-pill {
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 100px;
    padding: 8px 20px;
    font-size: 13px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.55);
  }
</style>
