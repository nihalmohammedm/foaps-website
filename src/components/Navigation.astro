<nav>
  <a href="/" class="logo">
    <img src="/foaps-logo.svg" alt="Foaps" />
  </a>
  <ul class="nav-links">
    <li><a href="/">Home</a></li>
    <li><a href="/products">Products</a></li>
    <li><a href="/why">Why Foaps</a></li>
    <li><a href="/contact">Contact</a></li>
  </ul>
  <div class="nav-end">
    <a href="#" class="btn btn-outline">Log in</a>
